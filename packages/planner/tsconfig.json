  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "strict": true, "noUncheckedIndexedAccess": false, "skipLibCheck": true,
    "resolveJsonModule": true, "esModuleInterop": true, "noEmit": true, "lib": ["ES2022"]
