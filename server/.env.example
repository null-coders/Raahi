# Database (SQLite file next to the schema). For Postgres: postgresql://user:pass@localhost:5432/raahi
DATABASE_URL="file:./prisma/raahi.db"

# Port for the API
PORT=4000

# Optional: free keys for prettier photos (falls back to Wikimedia when empty)
#   Pexels:   https://www.pexels.com/api/
#   Unsplash: https://unsplash.com/developers
PEXELS_API_KEY=
UNSPLASH_ACCESS_KEY=

# Storage: "prisma" (default) or "json" (no database; writes to server/.data)
DATA_BACKEND=prisma
